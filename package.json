{
  "name": "windsoft-agent-blueprint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "docs:check:mermaid": "node scripts/validate-mermaid.mjs",
    "test": "npm run test:unit",
    "test:watch": "node --test --watch \"tests/unit/**/*.test.js\" \"tests/contract/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\" \"tests/contract/**/*.test.js\"",
    "test:golden": "node scripts/run-golden-eval.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=line,html --workers=1",
    "test:ci": "npm run test:unit && npm run test:golden && npm run test:e2e:ci && npm run build"
  },
  "dependencies": {
    "@upstash/redis": "1.39.0",
    "jose": "6.2.12",
    "pdfjs-dist": "5.7.284",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.17.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
